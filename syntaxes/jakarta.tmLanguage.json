{
  "scopeName": "source.jkt",
  "name": "Jakarta",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.jakarta",
          "match": "//.*$"
        },
        {
          "name": "comment.block.jakarta",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": { "name": "punctuation.definition.comment.jakarta" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.jakarta",
          "match": "\\b(jika|lain|jika_lain|selama|untuk|dalam|ulangi|cocok|kasus|default|putus|lanjut)\\b"
        },
        {
          "name": "keyword.declaration.jakarta",
          "match": "\\b(fungsi|kelas|konstruktor|var|konstan|impor|dari|ekspor|kembali|baru|ini|super)\\b"
        },
        {
          "name": "keyword.operator.logical.jakarta",
          "match": "\\b(dan|atau|bukan)\\b"
        },
        {
          "name": "keyword.other.jakarta",
          "match": "\\b(cetak|tipe|dari|sebagai|dengan|coba|tangkap|akhirnya|lempar|angkat|statis|abstrak|virtual|override|publik|pribadi|proteksi|antarmuka|warisan|enum|modul|asinkron|tunggu|hasil)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.jakarta",
          "match": "\\b(benar|salah|kosong|tak_terhingga|bukan_angka)\\b"
        },
        {
          "name": "constant.language.null.jakarta",
          "match": "\\bkosong\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.jakarta",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.jakarta",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.jakarta",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.jakarta",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.template.jakarta",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.jakarta",
              "match": "\\\\."
            },
            {
              "begin": "\\$\\{",
              "end": "\\}",
              "name": "meta.template.expression.jakarta",
              "patterns": [
                { "include": "#keywords" },
                { "include": "#constants" },
                { "include": "#numbers" },
                { "include": "#functions" }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.jakarta",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.hex.jakarta",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.jakarta",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.integer.jakarta",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.jakarta",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.jakarta",
          "match": "\\b(angka|teks|boolean|daftar|peta|set|tuple|opsional|apapun|tidak_ada|kosong_tipe)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.jakarta",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.comparison.jakarta",
          "match": "(==|!=|<|>|<=|>=)"
        },
        {
          "name": "keyword.operator.assignment.jakarta",
          "match": "(=|\\+=|-=|\\*=|/=|%=)"
        },
        {
          "name": "keyword.operator.increment.jakarta",
          "match": "(\\+\\+|\\-\\-)"
        },
        {
          "name": "keyword.operator.arrow.jakarta",
          "match": "=>"
        },
        {
          "name": "keyword.operator.range.jakarta",
          "match": "\\.\\."
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.jakarta",
          "match": "[,;:.]"
        },
        {
          "name": "punctuation.bracket.jakarta",
          "match": "[{}\\[\\]()]"
        }
      ]
    }
  }
}